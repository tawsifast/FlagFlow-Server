generator client {
  provider = "prisma-client-js"
  output   = "..generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
    id String @id @default(uuid())
    name String
    email String
    password String
    role UserRole @default(USER)
    avatar String?
}

enum UserRole {
    USER
    DEVELOPER
    ADMIN
}